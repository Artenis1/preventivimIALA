# Kopjojeni te .env. Mos e shtoni .env në Git.
# Gjeneroni një fjalëkalim të ri: openssl rand -hex 32
# Përdorni shkronja/shifra në DB_PASSWORD, ose kodim URL kur ndërtoni DATABASE_URL.
DB_PASSWORD=replace-with-a-new-random-password
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# false lejohet vetëm lokalisht në HTTP. Vendoseni true në prodhim me HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080
SESSION_HOURS=24
MAX_UPLOAD_MB=15
# Vetëm për backend lokal jashtë Docker: përditësoni fjalëkalimin dhe hostin.
DATABASE_URL=postgresql+psycopg://smartestimate:replace-with-a-new-random-password@localhost:5432/smartestimate
STORAGE_DIR=./storage
# Opsionale. Shkruani kredencialet vetëm në .env ose secret manager, kurrë në frontend.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
HIGH_CONFIDENCE=0.93
MEDIUM_CONFIDENCE=0.65
